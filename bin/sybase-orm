#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Sybase ORM CLI.
 *
 * Usage:
 *     php bin/sybase-orm <command> [arguments]
 *     php bin/sybase-orm help
 *
 * Configuration:
 *     Create sybase-orm.config.php in your project root.
 */

// Find autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaded = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require_once $autoloadPath;
        $autoloaded = true;
        break;
    }
}

if (!$autoloaded) {
    fwrite(STDERR, "Error: Could not find Composer autoloader.\n");
    fwrite(STDERR, "Run 'composer install' first.\n");
    exit(1);
}

// Find configuration file
$configPaths = [
    getcwd() . '/sybase-orm.config.php',
    getcwd() . '/config/sybase-orm.config.php',
];

$config = null;
foreach ($configPaths as $configPath) {
    if (file_exists($configPath)) {
        $config = require $configPath;
        break;
    }
}

if ($config === null) {
    fwrite(STDERR, "Error: Configuration file not found.\n");
    fwrite(STDERR, "Create sybase-orm.config.php in your project root.\n");
    fwrite(STDERR, "Expected locations:\n");
    foreach ($configPaths as $path) {
        fwrite(STDERR, "  - {$path}\n");
    }
    exit(1);
}

// Build EntityManager
$em = \SybaseORM\ORM\OrmFactory::create($config);

// Build MigrationManager
$migrationsDir = $config['migrations_directory'] ?? getcwd() . '/migrations';
$migrationManager = new \SybaseORM\Migration\MigrationManager(
    connection: $em->getConnection(),
    metadataReader: $em->getMetadataReader(),
    dialect: $em->getDialect(),
    migrationsDirectory: $migrationsDir,
);

// Build command runner
$runner = new \SybaseORM\Console\CommandRunner();

// Register commands
$runner->add(new \SybaseORM\Console\Command\MigrateCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MigrateRollbackCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MigrateStatusCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MigrateGenerateCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MigratePreviewCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MigrateFreshCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MigrateResetCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\MakeMigrationCommand(
    migrationManager: $migrationManager,
    migrationsDirectory: $migrationsDir,
    entityClasses: $config['entity_classes'] ?? [],
));
$runner->add(new \SybaseORM\Console\Command\MakeEntityCommand(
    defaultEntityDirectory: $config['entity_directories'][0] ?? getcwd() . '/src/Entity',
    defaultNamespace: $config['entity_namespace'] ?? 'App\\Entity',
));
$runner->add(new \SybaseORM\Console\Command\SchemaValidateCommand($migrationManager));
$runner->add(new \SybaseORM\Console\Command\CacheClearCommand(
    proxyDirectory: $config['proxy_directory'] ?? null,
    metadataCacheDir: $config['metadata_cache_dir'] ?? null,
));
$runner->add(new \SybaseORM\Console\Command\OrmInfoCommand(
    metadataReader: $em->getMetadataReader(),
    entityClasses: $config['entity_classes'] ?? [],
));

exit($runner->run($argv));
