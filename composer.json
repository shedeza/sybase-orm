{
    "name": "shedeza/sybase-orm",
    "description": "Symfony Bundle ORM for Sybase ASE",
    "type": "symfony-bundle",
    "version": "2.7.8",
    "license": "MIT",
    "minimum-stability": "stable",
    "homepage": "https://github.com/shedeza/sybase-orm",
    "support": {
        "issues": "https://github.com/shedeza/sybase-orm/issues",
        "source": "https://github.com/shedeza/sybase-orm"
    },
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^6.0|^7.0",
        "symfony/console": "^6.0|^7.0|^8.0",
        "psr/log": "^2.0|^3.0",
        "ext-pdo_dblib": "*"
    },
    "autoload": {
        "psr-4": {
            "SybaseORM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SybaseORM\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
