{
    "name": "shedeza/sybase-orm-bundle",
    "description": "Symfony Bundle integration for shedeza/sybase-orm",
    "type": "symfony-bundle",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "shedeza/sybase-orm": "^3.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/console": "^6.0|^7.0|^8.0"
    },
    "conflict": {
        "shedeza/sybase-orm": "<3.0"
    },
    "autoload": {
        "psr-4": {
            "SybaseORM\\Bundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SybaseORM\\Bundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.50",
        "symfony/phpunit-bridge": "^6.0|^7.0|^8.0"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
