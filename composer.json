{
    "name": "shedeza/sybase-orm",
    "description": "Pure PHP ORM for Sybase ASE — framework-agnostic",
    "type": "library",
    "version": "3.0.0",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/log": "^2.0|^3.0",
        "ext-pdo_dblib": "*"
    },
    "autoload": {
        "psr-4": {
            "SybaseORM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SybaseORM\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.50"
    }
}
